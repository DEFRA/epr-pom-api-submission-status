    </SonarQubeSetting>
    <SonarQubeSetting Include="sonar.cpd.exclusions">
      <Value>
        **/CheckSplitterValidationError.cs,**/CheckSplitterValidationWarning.cs,**/ProducerValidationError.cs,**/ProducerValidationWarning.cs
      </Value>
    </SonarQubeSetting>
