{
    "Serilog": {
        "Using": [
            "Serilog",
            "Serilog.Sinks.ApplicationInsights"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Server.Kestrel": "Warning",
                "Microsoft.AspNetCore.StaticFiles": "Warning",
                "Microsoft.Identity": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithEnvironmentName",
            "WithProcessId"
        ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:yyyy-MM-dd'T'HH:mm:ss.ffffff} {Level:u3} {Message:lj}{NewLine}{Properties}{NewLine}{Exception}",
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
                }
            },
            {
                "Name": "ApplicationInsights",
                "Args": {
                    "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
                }
            }
        ]
    },
    "Database": {
        "ConnectionString": "https://devrwddbsco1401.documents.azure.com:443/",
        "AccountKey": "",
        "Name": "SubmissionDB",
        "MaxRetryCount": 30,
        "MaxRetryDelayInMilliseconds": 1000
    },
    "ConnectionStrings": {
        "REDIS_CONNECTION": ""
    },
    "LoggingApi": {
        "BaseUrl": ""
    },
    "Validation": {
        "MaxIssuesToProcess": 1000
    },
    "ServiceBus": {
        "ConnectionString": "",
        "AdminConnectionString": "",
        "RegistrationSubmittedForFeesCalculationTopicName": "defra.epr.registration.submit.for.fees",
        "RegistrationSubmittedForRegulatorApprovalTopicName": "defra.epr.registration.submit.for.regulator.approval"
    }}